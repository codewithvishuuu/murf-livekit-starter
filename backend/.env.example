# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# LiveKit SIP outbound calling (Day 6)
# Trunk ID of the outbound SIP trunk created in LiveKit Cloud
# (https://cloud.livekit.io/ → your project → SIP → Trunks). The dialing
# utility refuses to run without it. Never commit the real value here.
# Any outbound trunk works: a PSTN provider (Twilio/Telnyx/SignalWire/...) for
# E.164 phone calls, or a SIP registrar for direct SIP-user calls.
# -----------------------------------------------------------------------------
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=your_outbound_trunk_id_here
# Older setups may set the same trunk id under this name; it is used as a
# fallback when LIVEKIT_SIP_OUTBOUND_TRUNK_ID is not set:
# LIVEKIT_SIP_TRUNK_ID=your_outbound_trunk_id_here

# Optional outbound tuning (defaults shown):
# OUTBOUND_DIAL_NUMBER=+91XXXXXXXXXX   # number dialed when no CLI argument is given
# OUTBOUND_AGENT_NAME=my-agent         # agent dispatched into the outbound room
# OUTBOUND_RINGING_TIMEOUT_S=30        # seconds to ring before giving up
# OUTBOUND_MAX_CALL_DURATION_S=300     # safety cap for an unsupervised test call
# OUTBOUND_CALLER_NAME=Aarogya Sahayak # name spoken in the outbound opening
# SIP_OUTBOUND_HOST=sip.linphone.org   # trunk address; validated against sip: URI destinations

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Healthcare facility lookup (Day 5) — optional
# Uses the public OpenStreetMap Overpass API; no API key required.
# HEALTH_FACILITIES_TIMEOUT_S=10  # per-request timeout in seconds
#
# -----------------------------------------------------------------------------
# Human-help escalations (Day 7) — optional
# Local SQLite storage; no API key required. Paths default to the backend/data
# directory. ESCALATIONS_JSON_PATH is the human-readable queue mirror consumed
# by the frontend staff view (frontend/app/admin).
# ESCALATIONS_DB_PATH=backend/data/escalations.db
# ESCALATIONS_JSON_PATH=backend/data/escalations.json
